#!/usr/bin/env bash
# Acquire video-disc titles into Incoming. It never publishes or deletes media.
set -Eeuo pipefail
shopt -s extglob nullglob

DISC_INGEST_DEVICE=${DISC_INGEST_DEVICE:-/dev/sr0}
DISC_INGEST_DISC=${DISC_INGEST_DISC:-disc:0}
DISC_INGEST_MOVIES_ROOT=${DISC_INGEST_MOVIES_ROOT:-/srv/data/ingest/movies}
DISC_INGEST_TV_ROOT=${DISC_INGEST_TV_ROOT:-/srv/data/ingest/tv}
DISC_INGEST_MUSIC_INGEST=${DISC_INGEST_MUSIC_INGEST:-music-ingest}
DISC_INGEST_MAKEMKV=${DISC_INGEST_MAKEMKV:-makemkvcon}
DISC_INGEST_STATE_HOME=${DISC_INGEST_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/disc-ingest}
DISC_INGEST_CACHE_HOME=${DISC_INGEST_CACHE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/disc-ingest}
DISC_INGEST_CACHE_TTL=${DISC_INGEST_CACHE_TTL:-900}
VERBOSE=false DEBUG=false FORCE_RESCAN=false
DEST='' DEST_CREATED=false RIP_STARTED=false TYPE='' DISC_SUMMARY='' DISC_IDENTITY=''
declare -a TITLE_IDS=() TCOUNT_LINES=() NEW_FILES=() FINAL_NAMES=() OUTCOMES=()
declare -A TITLE_NAME=() TITLE_DURATION=() TITLE_SIZE=() BEFORE=()
SESSION_STARTED=$(date +%s) SESSION_ACTIVE_SECONDS=0 SESSION_DISCS_INSPECTED=0
SESSION_RIPPED=0 SESSION_FAILED=0 SESSION_CANCELLED=0 SESSION_BYTES=0
declare -a SESSION_ENTRIES=() SESSION_CATEGORIES=()

say() { printf '%s\n' "$*"; }; warn() { printf 'Warning: %s\n' "$*" >&2; }; die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
cancel() { say 'Cancelled. Nothing was ripped.'; exit 0; }
trim() { local v=$1; v=${v##+([[:space:]])}; v=${v%%+([[:space:]])}; printf '%s' "$v"; }
ask() { local n=$1 p=$2 a; if ! IFS= read -r -p "$p" a; then say; cancel; fi; printf -v "$n" '%s' "$a"; }
valid_basename() { [[ -n $1 && $1 != */* && $1 != . && $1 != .. ]]; }
normalise_mkv_name() { local v; v=$(trim "$1"); valid_basename "$v" || return 1; [[ $v == *.mkv ]] || v+=.mkv; printf '%s' "$v"; }
format_time() { local s=${1:-0}; printf '%02d:%02d' "$((s/60))" "$((s%60))"; }
format_bytes() { local b=${1:-0}; if ((b >= 1073741824)); then awk -v b="$b" 'BEGIN {printf "%.1f GiB", b/1073741824}'; elif ((b >= 1048576)); then awk -v b="$b" 'BEGIN {printf "%.1f MiB", b/1048576}'; else printf '%s bytes' "$b"; fi; }
safe_log_field() { tr '\t\r\n' '   ' <<< "$1"; }
json_string() { local value=$1; value=${value//\\/\\\\}; value=${value//\"/\\\"}; value=${value//$'\n'/ }; printf '%s' "$value"; }
reset_disc_state() { DEST='' DEST_CREATED=false RIP_STARTED=false TYPE='' DISC_SUMMARY='' DISC_IDENTITY=''; TITLE_IDS=(); TCOUNT_LINES=(); NEW_FILES=(); FINAL_NAMES=(); OUTCOMES=(); TITLE_NAME=(); TITLE_DURATION=(); TITLE_SIZE=(); BEFORE=(); FORCE_RESCAN=true; }
record_session_entry() { local status=$1 bytes=$2 active=$3 titles=$4; SESSION_ENTRIES+=("$status|$TYPE|$DISC_SUMMARY|$bytes|$active|$titles|$DEST"); if [[ $status == success ]]; then SESSION_RIPPED=$((SESSION_RIPPED+1)); elif [[ $status == cancelled ]]; then SESSION_CANCELLED=$((SESSION_CANCELLED+1)); else SESSION_FAILED=$((SESSION_FAILED+1)); fi; SESSION_ACTIVE_SECONDS=$((SESSION_ACTIVE_SECONDS+active)); SESSION_BYTES=$((SESSION_BYTES+bytes)); SESSION_CATEGORIES+=("$TYPE"); }
session_statistics() { local now elapsed entry status category disc bytes active titles dest; now=$(date +%s); elapsed=$((now-SESSION_STARTED)); say; say 'Physical Media Session'; say "  Discs inspected:  $SESSION_DISCS_INSPECTED"; say "  Discs ripped:     $SESSION_RIPPED"; say "  Failed/cancelled: $SESSION_FAILED/$SESSION_CANCELLED"; say "  Media produced:   $(format_bytes "$SESSION_BYTES")"; say "  Active rip time:  $(format_time "$SESSION_ACTIVE_SECONDS")"; say "  Session duration: $(format_time "$elapsed")"; if ((${#SESSION_ENTRIES[@]})); then say; say 'Ripped this session:'; for entry in "${SESSION_ENTRIES[@]}"; do IFS='|' read -r status category disc bytes active titles dest <<< "$entry"; printf '  %s %s (%s, %s, %s)\n' "$([[ $status == success ]] && printf ✓ || printf '!')" "${disc:-Unnamed disc}" "$(format_bytes "$bytes")" "$(format_time "$active")" "$status"; done; fi; return 0; }
write_session_record() { local directory target entry status category disc bytes active titles dest first=true; directory="$DISC_INGEST_STATE_HOME/sessions"; mkdir -p -- "$directory" || return; target="$directory/$(date +%Y%m%dT%H%M%S)-$$.json"; { printf '{\n  "schema": "disc-ingest-session-v1",\n  "started_at_epoch": %s,\n  "duration_seconds": %s,\n  "active_rip_seconds": %s,\n  "discs_inspected": %s,\n  "discs_ripped": %s,\n  "failed_discs": %s,\n  "cancelled_discs": %s,\n  "bytes_produced": %s,\n  "discs": [' "$SESSION_STARTED" "$(( $(date +%s)-SESSION_STARTED ))" "$SESSION_ACTIVE_SECONDS" "$SESSION_DISCS_INSPECTED" "$SESSION_RIPPED" "$SESSION_FAILED" "$SESSION_CANCELLED" "$SESSION_BYTES"; for entry in "${SESSION_ENTRIES[@]}"; do IFS='|' read -r status category disc bytes active titles dest <<< "$entry"; [[ $first == true ]] || printf ','; first=false; printf '\n    {"status":"%s","category":"%s","disc":"%s","bytes":%s,"active_seconds":%s,"titles":"%s","destination":"%s"}' "$(json_string "$status")" "$(json_string "$category")" "$(json_string "$disc")" "$bytes" "$active" "$(json_string "$titles")" "$(json_string "$dest")"; done; printf '\n  ]\n}\n'; } > "$target"; }
usage() { cat <<'EOF'
Usage: disc-ingest [--verbose|--debug] [--rescan] [status|help]

Interactive physical-media entry point. Video extraction is delegated to
MakeMKV; Audio CD work is delegated to music-ingest cd. Video output is placed
in Incoming only and is never published or deleted by this command.
EOF
}
on_interrupt() { say; if [[ $RIP_STARTED == true ]]; then say "Interrupted. Any completed or partial output was retained in: ${DEST:-<none>}"; else cleanup_empty_destination; say 'Cancelled. Nothing was ripped.'; fi; exit 130; }
trap on_interrupt INT TERM
check_drive() { [[ -e $DISC_INGEST_DEVICE ]] || die "Optical drive is unavailable: $DISC_INGEST_DEVICE. Check the device path and drive connection."; [[ -r $DISC_INGEST_DEVICE ]] || die "Optical drive is not readable: $DISC_INGEST_DEVICE. Check permissions and cdrom membership."; }
check_root() { [[ -d $1 && -w $1 ]] || die "$2 ingest root is unavailable or not writable: $1"; }
phase_name() { local p=${1,,}; case $p in *scan*cd*|*detect*) printf 'Detecting drive';; *open*) printf 'Opening disc';; *file*system*) printf 'Reading filesystem';; *title*set*) printf 'Processing title sets';; *content*) printf 'Scanning contents';; *process*title*|*title*processing*) printf 'Processing titles';; *saving*|*mkv*) printf 'Finalizing MKV';; *) printf '%s' "$1";; esac; }
show_progress() { :; } # Rendering is handled from the complete PRGV triple below.
operation_log() { local kind=$1 stamp; stamp=$(date +%Y%m%dT%H%M%S); mkdir -p -- "$DISC_INGEST_STATE_HOME/logs"; printf '%s/%s-%s.makemkv.log' "$DISC_INGEST_STATE_HOME/logs" "$stamp" "$kind"; }

# MakeMKV documents PRGT/PRGC as progress titles and PRGV as current,total,max.
# `current` describes the current sub-operation; `total` is operation-wide.
# Both use `max` as their denominator.  In particular, current/max reaching
# 100% does not mean the rip is finished while total/max is still advancing.
run_makemkv() {
  local log=$1; shift
  local line phase='' cur='' total='' max='' started status last_phase='' last_current_phase='' last_overall=-1 last_bucket=-1 last_render=0 last_total=-1 last_sample_time=0 samples=0 eta='' pipe pid now overall current_pct bucket elapsed rate remaining
  local tty=false operation=inspection
  [[ " $* " == *" mkv "* ]] && operation=ripping
  [[ -t 1 ]] && tty=true
  render() { local message=$1
    if [[ $tty == true ]]; then printf '\r\033[2K%s' "$message"
    else say "$message"
    fi
  }
  finish_render() { [[ $tty == true ]] && printf '\n'; }
  started=$(date +%s); : > "$log"; pipe=$(mktemp -u "${TMPDIR:-/tmp}/disc-ingest-progress.XXXXXX"); mkfifo -- "$pipe"
  "$DISC_INGEST_MAKEMKV" --robot --progress=-same "$@" >"$pipe" 2>&1 & pid=$!
  while IFS= read -r line; do
    printf '%s\n' "$line" >> "$log"; [[ $DEBUG == true ]] && say "$line"
    if [[ $line =~ ^PRG[TC]:[0-9]+,[0-9]+,\"(.*)\"$ ]]; then
      phase=${BASH_REMATCH[1]}
      if [[ $(phase_name "$phase") != "$last_phase" ]]; then
        last_phase=$(phase_name "$phase"); last_render=$(date +%s)
        [[ $tty == false ]] && say "Current: $last_phase"
      fi
      [[ $VERBOSE == true ]] && say "MakeMKV phase: $phase"
    elif [[ $line =~ ^PRGV:([0-9]+),([0-9]+),([0-9]+)$ ]]; then cur=${BASH_REMATCH[1]}; total=${BASH_REMATCH[2]}; max=${BASH_REMATCH[3]}
      if [[ $max =~ ^[1-9][0-9]*$ && $total =~ ^[0-9]+$ && $total -le $max && $cur =~ ^[0-9]+$ && $cur -le $max ]]; then
        now=$(date +%s); overall=$((total*100/max)); current_pct=$((cur*100/max)); bucket=$((overall/10)); elapsed=$((now-started)); eta=''
        # A scope reset invalidates any prior rate estimate until a new
        # monotonic sample sequence is established.
        if ((last_total >= 0 && total < last_total)); then samples=0; last_sample_time=0; fi
        if ((last_total >= 0 && total > last_total && now > last_sample_time)); then
          samples=$((samples + 1))
          if ((samples >= 2 && overall >= 5)); then
            rate=$(( (total-last_total) / (now-last_sample_time) ))
            if ((rate > 0)); then remaining=$(( (max-total)/rate )); ((remaining >= 0 && remaining < 86400)) && eta=" | ETA ~$(format_time "$remaining")"; fi
          fi
        fi
        last_total=$total; last_sample_time=$now
        if ((current_pct == 100)) && [[ $last_current_phase != "$last_phase" ]]; then
          [[ $tty == false ]] && say "Current: ${last_phase:-Working} complete"
          last_current_phase=$last_phase
        elif ((current_pct < 100)); then
          last_current_phase=''
        fi
        now=$(date +%s)
        if ((overall > last_overall)) && { [[ $tty == true ]] || ((bucket > last_bucket)); }; then
          if [[ $tty == true ]]; then
            local width=$(( ${COLUMNS:-80} - 44 )) filled empty
            ((width<10)) && width=10; filled=$((overall*width/100)); empty=$((width-filled))
            render "${operation^}: [$(printf '%*s' "$filled" '' | tr ' ' '█')$(printf '%*s' "$empty" '' | tr ' ' '░')] ${overall}% | $(format_time "$elapsed")${eta} | ${last_phase:-Working}"
          else
            render "${operation^}: ${overall}% | Elapsed $(format_time "$elapsed")${eta} | Current: ${last_phase:-Working}"
          fi
          last_overall=$overall; last_bucket=$bucket; last_render=$now
        elif ((now-last_render >= ${DISC_INGEST_HEARTBEAT_SECONDS:-20})); then
          render "${operation^}: ${overall}% | Elapsed $(format_time "$elapsed") | Current: ${last_phase:-Working}"
          last_render=$now
        fi
      fi
    elif [[ $line =~ ^MSG:[0-9]+,[0-9]+,[0-9]+,\"([^\"]*) ]]; then [[ $VERBOSE == true ]] && say "MakeMKV: ${BASH_REMATCH[1]}"; fi
  done < "$pipe"
  wait "$pid"; status=$?; finish_render; rm -f -- "$pipe"; return "$status"
}
parse_robot() { local robot=$1 line id field value; TCOUNT_LINES=(); TITLE_IDS=(); TITLE_NAME=(); TITLE_DURATION=(); TITLE_SIZE=(); DISC_SUMMARY=''; DISC_IDENTITY=''; while IFS= read -r line || [[ -n $line ]]; do
  if [[ $line =~ ^TCOUNT:([0-9]+)$ ]]; then TCOUNT_LINES+=("${BASH_REMATCH[1]}")
  elif [[ $line =~ ^TINFO:([0-9]+),([0-9]+),[0-9]+,\"(.*)\"$ ]]; then id=${BASH_REMATCH[1]}; field=${BASH_REMATCH[2]}; value=${BASH_REMATCH[3]}; [[ " ${TITLE_IDS[*]} " == *" $id "* ]] || TITLE_IDS+=("$id"); case $field in 2) TITLE_NAME[$id]=$value;; 9) TITLE_DURATION[$id]=$value;; 10) TITLE_SIZE[$id]=$value;; esac
  elif [[ $line =~ ^CINFO:.*\"(.*)\"$ ]]; then value=${BASH_REMATCH[1]}; [[ -z $DISC_SUMMARY ]] && DISC_SUMMARY=$value
  elif [[ $line =~ ^DRV:.*\"([^\"]*)\",\"([^\"]*)\" ]]; then DISC_IDENTITY="${BASH_REMATCH[1]}|${BASH_REMATCH[2]}"; fi
done < "$robot"; }
cache_file() { printf '%s/current.tsv' "$DISC_INGEST_CACHE_HOME"; }; cache_identity() { printf '%s' "$DISC_IDENTITY" | sha256sum | awk '{print $1}'; }
write_cache() { local file id i; mkdir -p -- "$DISC_INGEST_CACHE_HOME"; file=$(cache_file); id=$(cache_identity); { printf 'v1\t%s\t%s\n' "$(date +%s)" "$id"; printf 'summary\t%s\n' "$DISC_SUMMARY"; printf 'count\t%s\n' "${TCOUNT_LINES[0]}"; for i in "${TITLE_IDS[@]}"; do printf 'title\t%s\t%s\t%s\t%s\n' "$i" "${TITLE_NAME[$i]:-}" "${TITLE_DURATION[$i]:-}" "${TITLE_SIZE[$i]:-}"; done; } > "$file"; }
load_cache() { local file ts id now key a b c d probe; file=$(cache_file); [[ -r $file && $FORCE_RESCAN == false ]] || return 1; IFS=$'\t' read -r key ts id < "$file" || return 1; [[ $key == v1 && $ts =~ ^[0-9]+$ ]] || return 1; now=$(date +%s); ((now-ts <= DISC_INGEST_CACHE_TTL)) || return 1; probe=$(mktemp); "$DISC_INGEST_MAKEMKV" --robot --noscan info "$DISC_INGEST_DISC" >"$probe" 2>&1 || { rm -f -- "$probe"; return 1; }; parse_robot "$probe"; rm -f -- "$probe"; [[ -n $DISC_IDENTITY && $(cache_identity) == "$id" ]] || return 1; TCOUNT_LINES=(); TITLE_IDS=(); TITLE_NAME=(); TITLE_DURATION=(); TITLE_SIZE=(); while IFS=$'\t' read -r key a b c d; do case $key in summary) DISC_SUMMARY=$a;; count) TCOUNT_LINES=($a);; title) TITLE_IDS+=($a); TITLE_NAME[$a]=$b; TITLE_DURATION[$a]=$c; TITLE_SIZE[$a]=$d;; esac; done < "$file"; say "Using inspection cached $((now-ts))s ago for ${DISC_SUMMARY:-current disc}."; }
inspect_disc() { local log rc; check_drive; if load_cache; then return; fi; SESSION_DISCS_INSPECTED=$((SESSION_DISCS_INSPECTED+1)); log=$(operation_log inspect); say; say 'Inspecting disc...'; say 'Opening disc and scanning titles; this can take several minutes.'; if run_makemkv "$log" info "$DISC_INGEST_DISC"; then rc=0; else rc=$?; fi; parse_robot "$log"; if ((${#TCOUNT_LINES[@]} != 1)); then warn 'MakeMKV inspection did not return one valid TCOUNT record.'; warn "Diagnostic log: $log"; return 2; fi; if ((10#${TCOUNT_LINES[0]} == 0)); then say "No readable video disc detected in $DISC_INGEST_DEVICE."; say 'Insert a DVD/video disc or choose Audio CD.'; return 3; fi; if ((rc)); then warn "MakeMKV inspection failed (exit $rc)."; warn "Diagnostic log: $log"; return 2; fi; [[ -n $DISC_IDENTITY ]] && write_cache || warn 'No strong MakeMKV disc identity was exposed; inspection was not cached.'; }
show_disc() { local id; say; say "Drive: $DISC_INGEST_DEVICE"; [[ -n $DISC_SUMMARY ]] && say "Disc metadata: $DISC_SUMMARY"; say "Titles reported: ${TCOUNT_LINES[0]}"; for id in "${TITLE_IDS[@]}"; do printf '  ID %s' "$id"; [[ -n ${TITLE_NAME[$id]:-} ]] && printf ' | %s' "${TITLE_NAME[$id]}"; [[ -n ${TITLE_DURATION[$id]:-} ]] && printf ' | duration %s' "${TITLE_DURATION[$id]}"; [[ -n ${TITLE_SIZE[$id]:-} ]] && printf ' | size %s' "${TITLE_SIZE[$id]}"; printf '\n'; done; }
title_exists() { local x=$1 i; for i in "${TITLE_IDS[@]}"; do [[ $i == "$x" ]] && return 0; done; return 1; }
choose_titles() { local s id raw; say; say '[1] All titles'; say '[2] One title'; say '[3] Specific title IDs'; say '[4] Cancel'; ask s 'Choose [1-4]: '; case $s in 1) TITLE_IDS=(all);; 2) ask id 'Title ID: '; [[ $id =~ ^[0-9]+$ ]] && title_exists "$id" || die 'Title ID is not present on this disc.'; TITLE_IDS=($id);; 3) ask raw 'Title IDs, comma-separated: '; IFS=, read -ra TITLE_IDS <<< "$raw"; for id in "${!TITLE_IDS[@]}"; do TITLE_IDS[$id]=$(trim "${TITLE_IDS[$id]}"); [[ ${TITLE_IDS[$id]} =~ ^[0-9]+$ ]] && title_exists "${TITLE_IDS[$id]}" || die 'A supplied title ID is not present on this disc.'; done;; 4) cancel;; *) die 'Invalid selection.';; esac; }
snapshot_mkvs() { local p n; BEFORE=(); for p in "$DEST"/*.mkv; do [[ -f $p ]] || continue; n=${p##*/}; BEFORE[$n]=1; done; }; discover_new_mkvs() { local p n; NEW_FILES=(); sleep "${DISC_INGEST_OUTPUT_SETTLE_SECONDS:-1}"; for p in "$DEST"/*.mkv; do [[ -f $p ]] || continue; n=${p##*/}; [[ -v "BEFORE[$n]" ]] || NEW_FILES+=("$n"); done; }
rename_output() { local source=$1 desired=${2:-} action entered target; if [[ -z $desired ]]; then ask entered "Name [keep $source]: "; [[ -n $(trim "$entered") ]] || return 0; desired=$entered; else say "MakeMKV created: $source"; say "Rename to: $(normalise_mkv_name "$desired" || printf '<invalid>')"; ask action '[A]ccept, [E]dit filename, [K]eep MakeMKV filename: '; case ${action^^} in ''|A);; E) ask desired 'Filename: ';; K) return 0;; *) warn 'Invalid rename choice; keeping MakeMKV filename.'; return 0;; esac; fi; target=$(normalise_mkv_name "$desired") || { warn 'Unsafe filename; keeping MakeMKV filename.'; return 0; }; [[ $target == "$source" ]] && return 0; [[ ! -e $DEST/$target ]] || { warn "Refusing to overwrite existing file: $target"; return 0; }; mv -- "$DEST/$source" "$DEST/$target"; FINAL_NAMES+=("$source=>$target"); }
rip_title() { local id=$1 desired=${2:-} rc log; snapshot_mkvs; RIP_STARTED=true; log=$(operation_log rip); say; say "Ripping title $id..."; if run_makemkv "$log" mkv "$DISC_INGEST_DISC" "$id" "$DEST"; then rc=0; else rc=$?; fi; discover_new_mkvs; if ((rc)); then OUTCOMES+=("$id:failed"); warn "Rip failed while reading title $id."; warn "Diagnostic log: $log"; return; fi; if ((${#NEW_FILES[@]} != 1)); then OUTCOMES+=("$id:ambiguous-${#NEW_FILES[@]}"); warn "Title $id produced ${#NEW_FILES[@]} new MKVs; no rename was attempted."; return; fi; rename_output "${NEW_FILES[0]}" "$desired"; OUTCOMES+=("$id:success"); }
rip_all() { local rc log f; snapshot_mkvs; RIP_STARTED=true; log=$(operation_log rip); say; say 'Ripping all titles...'; if run_makemkv "$log" mkv "$DISC_INGEST_DISC" all "$DEST"; then rc=0; else rc=$?; fi; discover_new_mkvs; if ((rc)); then OUTCOMES+=(all:failed); warn "MakeMKV failed. Diagnostic log: $log"; return; fi; ((${#NEW_FILES[@]})) || { OUTCOMES+=(all:ambiguous-0); warn 'MakeMKV created no new MKVs; no rename was attempted.'; return; }; for f in "${NEW_FILES[@]}"; do rename_output "$f" ''; done; OUTCOMES+=("all:success-${#NEW_FILES[@]}"); }
cleanup_empty_destination() { [[ $DEST_CREATED == true && -n $DEST ]] && rmdir -- "$DEST" 2>/dev/null || true; }
write_log() { local outcome; mkdir -p -- "$DISC_INGEST_STATE_HOME" || return; outcome=$(IFS=,; printf '%s' "${OUTCOMES[*]}"); [[ -e $DISC_INGEST_STATE_HOME/operations.tsv ]] || printf 'timestamp\tdrive\tdisc\tcategory\ttitles\tdestination\tresults\trenames\n' > "$DISC_INGEST_STATE_HOME/operations.tsv"; printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date --iso-8601=seconds)" "$(safe_log_field "$DISC_INGEST_DEVICE")" "$(safe_log_field "$DISC_SUMMARY")" "$TYPE" "${TITLE_IDS[*]}" "$DEST" "$outcome" "${FINAL_NAMES[*]}" >> "$DISC_INGEST_STATE_HOME/operations.tsv"; }
audio_cd() { local profile; check_drive; say; say 'Audio CD selected.'; say 'Drive detected. Delegating secure CD workflow to music-ingest.'; say '[S] Secure (five retries per track)'; say '[B] Bounded secure (one retry; checksums retained)'; ask profile 'Choose [S/b]: '; case "${profile^^}" in ''|S) profile=secure;; B) profile=bounded;; *) warn 'Invalid CD rip profile.'; return 2;; esac; command -v "$DISC_INGEST_MUSIC_INGEST" >/dev/null 2>&1 || { warn 'music-ingest is unavailable; install or expose it on PATH.'; return 2; }; "$DISC_INGEST_MUSIC_INGEST" cd --device "$DISC_INGEST_DEVICE" --rip-profile "$profile"; }
status() { local mk; say 'Physical Media Ingest status'; say "Optical device: $DISC_INGEST_DEVICE $([[ -e $DISC_INGEST_DEVICE ]] && printf '(present)' || printf '(unavailable)')"; if mk=$(command -v "$DISC_INGEST_MAKEMKV" 2>/dev/null); then say "MakeMKV: available ($mk)"; else say 'MakeMKV: not installed'; fi; say "music-ingest: $(command -v "$DISC_INGEST_MUSIC_INGEST" >/dev/null 2>&1 && printf available || printf unavailable)"; say "Whipper: $(command -v whipper >/dev/null 2>&1 && whipper --version 2>/dev/null || printf 'not installed')"; say 'Whipper drive offset: query in music-ingest CD setup (never assumed).'; say "Movies Incoming: $DISC_INGEST_MOVIES_ROOT"; say "TV Incoming: $DISC_INGEST_TV_ROOT"; }
destination_bytes() { local p total=0; for p in "$DEST"/*.mkv; do [[ -f $p ]] && total=$((total + $(stat -c %s -- "$p"))); done; printf '%s' "$total"; }
video_flow() {
  local kind=$1 root=$2 name confirm choice id desired started bytes status=success
  check_root "$root" "$kind"; inspect_disc || return
  show_disc; ask choice '[R]escan or [C]ontinue: '; [[ ${choice^^} == R ]] && { FORCE_RESCAN=true; inspect_disc || return; show_disc; }
  choose_titles
  while :; do
    ask name "$kind release folder name: "; name=$(trim "$name"); valid_basename "$name" || { warn 'Folder name must be a non-empty safe basename.'; continue; }
    DEST="$root/$name"; [[ ! -e $DEST ]] && break
    say "Destination already exists: $DEST"; ask choice '[C]hoose a different name or [X] Cancel: '; [[ ${choice^^} == C ]] || return 2
  done
  declare -A planned=()
  if [[ $kind == Movie && ${#TITLE_IDS[@]} -eq 1 && ${TITLE_IDS[0]} != all ]]; then planned[${TITLE_IDS[0]}]=$name
  elif [[ $kind == TV && ${TITLE_IDS[0]} != all ]]; then for id in "${TITLE_IDS[@]}"; do ask desired "Desired name for title $id [keep generated]: "; planned[$id]=$(trim "$desired"); done; fi
  say; say 'Planned rip'; say "Drive:       $DISC_INGEST_DEVICE"; say "Disc:        $DISC_SUMMARY"; say "Category:    $kind"; say "Destination: $DEST"; say "Titles:      ${TITLE_IDS[*]}"
  ask confirm 'Type RIP to begin: '; [[ $confirm == RIP ]] || return 2
  mkdir -- "$DEST" || die "Could not create destination: $DEST"; DEST_CREATED=true; started=$(date +%s)
  if [[ ${TITLE_IDS[0]} == all ]]; then rip_all; else for id in "${TITLE_IDS[@]}"; do rip_title "$id" "${planned[$id]:-}"; done; fi
  write_log; bytes=$(destination_bytes)
  if [[ " ${OUTCOMES[*]} " == *failed* || " ${OUTCOMES[*]} " == *ambiguous* ]]; then status=failed; fi
  record_session_entry "$status" "$bytes" "$(( $(date +%s)-started ))" "${TITLE_IDS[*]}"
  [[ $status == success ]] && { say; say 'DVD rip complete.'; say "Stored in: $DEST"; }
  [[ $status == success ]]
}
organise_session_media() { local kind; ((${#SESSION_CATEGORIES[@]})) || { say 'No successful video discs in this session.'; return; }; kind=${SESSION_CATEGORIES[0]}; for TYPE in "${SESSION_CATEGORIES[@]}"; do [[ $TYPE == "$kind" ]] || { kind=''; break; }; done; if [[ -z $kind ]]; then ask kind '[M]ovies or [T]V: '; [[ ${kind^^} == M ]] && kind=Movie || kind=TV; fi; command -v video-ingest >/dev/null 2>&1 || { warn 'video-ingest is unavailable on PATH.'; return; }; [[ $kind == Movie ]] && video-ingest movies || video-ingest tv; }
main() {
  local choice rc
  case ${1:-} in --help|help) usage; return;; --verbose) VERBOSE=true; shift;; --debug) DEBUG=true; VERBOSE=true; shift;; --rescan) FORCE_RESCAN=true; shift;; status) status; return;; '') ;; *) usage; die "Unknown argument: $1";; esac
  command -v "$DISC_INGEST_MAKEMKV" >/dev/null 2>&1 || die 'makemkvcon is not installed or not in PATH.'
  while :; do
    say; say 'Physical Media Ingest'; say '[1] Movie DVD / video disc'; say '[2] TV DVD / video disc'; say '[3] Audio CD'; say '[4] Inspect inserted disc'; say '[5] Drive / configuration status'; say '[6] Session statistics'; say '[7] Organise ripped media'; say '[8] Finish'
    ask choice 'Choose [1-8]: '
    case $choice in
      1) TYPE=Movie; if video_flow Movie "$DISC_INGEST_MOVIES_ROOT"; then rc=0; else rc=$?; fi; [[ $rc -eq 2 ]] && record_session_entry cancelled 0 0 '' ; reset_disc_state ;;
      2) TYPE=TV; if video_flow TV "$DISC_INGEST_TV_ROOT"; then rc=0; else rc=$?; fi; [[ $rc -eq 2 ]] && record_session_entry cancelled 0 0 '' ; reset_disc_state ;;
      3) audio_cd || true ;;
      4) if inspect_disc; then show_disc; fi ;;
      5) status ;;
      6) session_statistics ;;
      7) organise_session_media ;;
      8) session_statistics; write_session_record; return ;;
      *) warn 'Invalid selection.' ;;
    esac
  done
}
main "$@"
